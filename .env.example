# AegisFlow Environment Variables Template

# Application & Environment
APP_NAME=AegisFlow
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=aegisflow_jwt_secret_key_change_in_production_32bytes_min

# PostgreSQL Database
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_password_secure
POSTGRES_DB=aegisflow_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis_user:aegis_password_secure@localhost:5432/aegisflow_db

# Redis Online Feature Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aegisflow_fraud_scoring

# LLM / OpenAI API Key (for LangGraph agents)
OPENAI_API_KEY=sk-placeholder-replace-with-real-key

# PII Encryption Key (32-byte base64 encoded or hex key)
PII_ENCRYPTION_KEY=super_secret_pii_encryption_key_32b_len!

# Service URLs
INGESTION_SERVICE_URL=http://localhost:8001
SCORING_SERVICE_URL=http://localhost:8002
CASEWORK_SERVICE_URL=http://localhost:8003
INVESTIGATOR_SERVICE_URL=http://localhost:8004
